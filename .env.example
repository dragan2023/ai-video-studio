# Persistent state
export STUDIO_DATA_DIR="$PWD/data"

# Colon-separated roots accepted by the server-side material-library importer.
export STUDIO_IMPORT_ROOTS="/media:$HOME"
export STUDIO_COPY_IMPORTED_ASSETS=1
export STUDIO_WEB_ROOT="$PWD/web/dist"

# Optional OpenAI-compatible planning agent. Without these values the built-in
# deterministic planner remains available for local development.
export STUDIO_PLANNER_BASE_URL="http://127.0.0.1:8000/v1"
export STUDIO_PLANNER_MODEL="your-omni-or-llm-model"
# Hierarchical planning: creative director -> per-shot directors -> continuity critic.
export STUDIO_PLANNER_PIPELINE="hierarchical"
export STUDIO_PLANNER_TIMEOUT_SECONDS=300
export STUDIO_PLANNER_RETRY_ATTEMPTS=3
export STUDIO_PLANNER_RETRY_BACKOFF_SECONDS=2
export STUDIO_PLANNER_SHOT_CONCURRENCY=3
# Independent projects may keep planning after the creator switches away.
export STUDIO_PLANNER_PROJECT_CONCURRENCY=3
export STUDIO_PLANNER_CONTINUITY_CRITIC=1
# Optional local MiniMax-H3/style skill packs. Only the selected pack's
# continuity/audio excerpts are sent to the planner; packs are not concatenated.
export STUDIO_H3_SKILLS_DIR="/path/to/long-video-studio/skills"
# export STUDIO_PLANNER_API_KEY="..."

# Optional MiniMax-H3 serving endpoints. FL2VA and Ref2VA are separate model
# partitions and may be hosted on different nodes/ports.
export STUDIO_H3_FL2VA_URL="http://127.0.0.1:8091"
export STUDIO_H3_REF2VA_URL="http://127.0.0.1:8092"
export STUDIO_H3_TIMEOUT_SECONDS=7200

# Cross-project scheduler and server-authoritative ETA calibration. Change the
# profile name whenever the model, hardware, precision, or parallel layout
# changes so timings from incompatible deployments are not mixed.
export STUDIO_RENDER_MAX_CONCURRENCY=2
export STUDIO_RENDER_PROFILE="minimax-h3-s5000-tp4-te4-vpp4-flash"
export STUDIO_RENDER_FL2VA_BASELINE_SECONDS=396.2   # 10s / 50 steps
export STUDIO_RENDER_REF2VA_BASELINE_SECONDS=1713.8 # 10s / 50 steps

# Optional provider-neutral image-edit stage used to construct a story-aware
# anchor frame from ordered scene/character/prop references. The same contract
# accepts a local vLLM-Omni server or a hosted OpenAI-compatible vendor.
export STUDIO_IMAGE_EDIT_PROVIDER="disabled" # disabled|vllm-omni|openai-compatible
# export STUDIO_IMAGE_EDIT_BASE_URL="http://127.0.0.1:8093"
# export STUDIO_IMAGE_EDIT_MODEL="Qwen/Qwen-Image-Edit-2511"
# Optional exact Qwen token gate. Only set this when tokenizer.json is visible
# on the Studio host; a path that exists only inside the remote vLLM container
# must not be used. Prompts above 1000 Qwen text tokens are rejected locally.
# export STUDIO_IMAGE_EDIT_TOKENIZER_PATH="/models/Qwen-Image-Edit-2511/processor"
# export STUDIO_IMAGE_EDIT_API_KEY="..."
export STUDIO_IMAGE_EDIT_MAX_REFERENCES=4
export STUDIO_IMAGE_EDIT_TIMEOUT_SECONDS=600
export STUDIO_IMAGE_EDIT_ANCHOR_MODE=scene-cuts # first-shot|scene-cuts|every-shot
export STUDIO_IMAGE_EDIT_STEPS=40
export STUDIO_IMAGE_EDIT_TRUE_CFG_SCALE=4.0
export STUDIO_IMAGE_EDIT_GUIDANCE_SCALE=1.0

# Host media tools used for boundary-frame extraction and final assembly.
export STUDIO_FFMPEG=ffmpeg
export STUDIO_FFPROBE=ffprobe
